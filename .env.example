# Copy to .env for local development. Do not commit real secrets.

# Backend
CHIMERA_ENVIRONMENT=development
CHIMERA_DATABASE_URL=sqlite:///./local.db
CHIMERA_AI_PROVIDER=stub
CHIMERA_DEMO_MODE=true
CHIMERA_OPENAI_API_KEY=
CHIMERA_OPENAI_MODEL=gpt-4o-mini
CHIMERA_OPENAI_TIMEOUT_SECONDS=30
CHIMERA_OPENAI_MAX_RETRIES=2
CHIMERA_CORS_ORIGINS=http://localhost:3000
CHIMERA_REQUEST_ID_HEADER=X-Request-ID
CHIMERA_MAX_MESSAGE_LENGTH=8000

# Production example (do not commit real keys):
# CHIMERA_ENVIRONMENT=production
# CHIMERA_AI_PROVIDER=openai
# CHIMERA_DEMO_MODE=false
# CHIMERA_OPENAI_API_KEY=sk-...

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
